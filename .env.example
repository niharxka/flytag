# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app, so only public keys.
# Local stack: run `npm run db:start`; it prints the publishable key. The phone can't reach
# 127.0.0.1 (that's the phone itself), so use your Mac's Wi-Fi IP: `ipconfig getifaddr en0`.
EXPO_PUBLIC_SUPABASE_URL=http://YOUR-MAC-IP:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
